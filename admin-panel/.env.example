# FocusGuard Admin Panel — local configuration
#
# Copy this file to `.env` in the same directory and fill in the values.
# `.env` is git-ignored; never commit a real secret. The panel refuses to sign codes without it.

# ── REQUIRED ───────────────────────────────────────────────────────────────
# Master secret used to HMAC-sign support codes.
# MUST be byte-identical to `support.master.secret` in the app's local.properties
# (and the same value in the release CI job) — a mismatch produces codes that look
# valid here but are rejected on every phone.
VITE_SUPPORT_MASTER_SECRET=

# Comma-separated Google addresses allowed to open this console.
# Empty = the panel fails closed and shows a configuration error.
VITE_ADMIN_EMAILS=you@gmail.com,support-agent@gmail.com

# ── OPTIONAL (firebase.js falls back to the production project values) ─────
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=focusguard-e3791.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=focusguard-e3791
# VITE_FIREBASE_STORAGE_BUCKET=focusguard-e3791.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ── IMPORTANT ──────────────────────────────────────────────────────────────
# Vite inlines every VITE_* value into the JavaScript it ships. A panel published
# to public hosting therefore leaks the master secret to anyone who views source.
# Use `npm run dev` on the operator machine. Do not deploy this app to a public
# URL until code signing moves to a server endpoint (README, "Security model").
